# macOS
.DS_Store
.AppleDouble
.LSOverride

# Roblox / Rojo generated files
*.rbxl
*.rbxlx
/build/
/sourcemap.json

# Logs
*.log
/logs/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
/.tmp/
/tmp/

# Personal editor settings
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# Graphify knowledge graph: commit graph.json + GRAPH_REPORT.md + manifest.json
# so agents/teammates start with the map already extracted. Everything below
# is derived from graph.json and regenerates in seconds, offline, at no cost
# (`graphify cluster-only .`) — kept local to avoid large generated-file diffs
# on every commit from the auto-rebuild hook.
/graphify-out/cache/
/graphify-out/cost.json
/graphify-out/graph.html
/graphify-out/.graphify_analysis.json
/graphify-out/.graphify_labels.json
/graphify-out/.graphify_labels.json.sig

# graphify auto-backs up graph.json (+ sidecar files) into a dated folder
# before overwriting a "curated" or semantic graph — one new folder per day
# the graph changes. Git is already our history/backup, so these pre-overwrite
# snapshots stay local instead of accumulating in the repo forever.
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify's Claude Code PreToolUse hook bakes in an absolute path to the
# local `graphify` executable (by design, for cross-shell reliability), so
# it isn't portable between machines/users. Each developer regenerates it
# locally with `graphify claude install` (see README).
/.claude/settings.json
